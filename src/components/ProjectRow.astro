---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Work } from "../data/profile";

interface Props {
  item: Work;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { item, image, imageAlt = "" } = Astro.props;
const meta = [item.role, item.context, item.when].filter(Boolean).join(", ");
---

<article class={`prow ${image ? "has-image" : ""}`} id={item.slug}>
  <div class="prow-text">
    <h3 class="prow-title">
      {item.page ? <a href={`/work/${item.slug}/`}>{item.name}</a> : item.name}
    </h3>
    <p class="prow-meta">{meta}</p>
    <p class="prow-lead">{item.lead}</p>
    {item.result && <p class="prow-result">{item.result}</p>}
    <ul class="tags prow-stack" aria-label="Built with">
      {item.stack.map((s) => <li>{s}</li>)}
    </ul>
    {
      (item.page || item.links.length > 0) && (
        <p class="link-row prow-links">
          {item.page && <a href={`/work/${item.slug}/`}>Case study</a>}
          {item.links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </p>
      )
    }
  </div>
  {
    image && (
      <div class="prow-image">
        <Image src={image} alt={imageAlt} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 26rem" />
      </div>
    )
  }
</article>

<style>
  .prow {
    display: grid;
    gap: 2rem;
    padding-block: 2rem;
    border-top: 1px solid var(--border);
  }
  .prow:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .prow.has-image {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: start;
  }
  .prow-title {
    font-size: 1.25rem;
  }
  .prow-title a {
    color: var(--text);
  }
  .prow-title a:hover {
    color: var(--accent);
  }
  .prow-meta {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .prow-lead {
    margin-top: 0.75rem;
    max-width: var(--measure);
  }
  .prow-result {
    margin-top: 0.6rem;
    max-width: var(--measure);
    font-weight: 500;
  }
  .prow-stack {
    margin-top: 0.9rem;
  }
  .prow-links {
    margin-top: 0.9rem;
  }
  .prow-image {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }
  .prow-image :global(img) {
    width: 100%;
    height: auto;
  }
  @media (max-width: 860px) {
    .prow.has-image {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
</style>
