---
// The difficulty router from the AICI paper, with the thresholds from
// adaptive_gptoss_inference.py and the ViVQA-X results from the README.
import { routerThresholds as T, vivqaX } from "../data/profile";

const MIN = 0.55;
const MAX = 0.72;
const pct = (v: number) => ((v - MIN) / (MAX - MIN)) * 100;
const maxTime = Math.max(...vivqaX.map((r) => r.time));
const id = "rt-" + Math.random().toString(36).slice(2, 7);
---

<div class="figure router" data-router data-high={T.high} data-medium={T.medium}>
  <div class="rt-head">
    <label for={id}>How well Gemini's caption matches the photo, scored by CLIP</label>
    <output for={id} class="rt-s num" data-s>0.660</output>
  </div>

  <div class="rt-track">
    <div class="rt-zones" aria-hidden="true">
      <span class="z-high" style={`width:${pct(T.high)}%`}>High effort</span>
      <span class="z-med" style={`width:${pct(T.medium) - pct(T.high)}%`}></span>
      <span class="z-low">Low effort</span>
    </div>
    <input id={id} type="range" min={MIN} max={MAX} step="0.001" value="0.66" data-input />
    <div class="rt-ticks" aria-hidden="true">
      <span style={`left:${pct(T.high)}%`}>{T.high.toFixed(2)}</span>
      <span style={`left:${pct(T.medium)}%`}>{T.medium.toFixed(2)}</span>
    </div>
  </div>

  <p class="rt-verdict" aria-live="polite" data-verdict></p>

  <div class="rt-results">
    <p class="rt-sub">Full ViVQA-X run, wall-clock time and ROUGE-L</p>
    <ul class="rt-bars" data-bars>
      {
        vivqaX.map((r) => (
          <li class={`rt-row mode-${r.mode.toLowerCase()}`}>
            <span class="rt-mode">{r.mode === "Adaptive" ? "Adaptive (ours)" : `Always ${r.mode.toLowerCase()}`}</span>
            <span class="rt-bar-wrap">
              <span class="rt-bar" style={`--w:${(r.time / maxTime) * 100}%`} />
            </span>
            <span class="rt-time num">{r.time.toLocaleString("en-US")} s</span>
            <span class="rt-score num">{r.rougeL.toFixed(3)}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  const verdicts = {
    high: "The caption leaves something out, so GPT-OSS reasons at high effort before answering.",
    medium: "A borderline match gets medium effort.",
    low: "The caption already describes the photo, so GPT-OSS answers with low effort.",
  };
  for (const root of document.querySelectorAll<HTMLElement>("[data-router]")) {
    const input = root.querySelector<HTMLInputElement>("[data-input]")!;
    const out = root.querySelector<HTMLElement>("[data-s]")!;
    const verdict = root.querySelector<HTMLElement>("[data-verdict]")!;
    const high = Number(root.dataset.high);
    const medium = Number(root.dataset.medium);
    const update = () => {
      const s = Number(input.value);
      const level = s < high ? "high" : s < medium ? "medium" : "low";
      out.textContent = s.toFixed(3);
      root.dataset.level = level;
      verdict.textContent = verdicts[level];
      input.setAttribute("aria-valuetext", `${s.toFixed(3)}, ${level} reasoning effort`);
    };
    input.addEventListener("input", update);
    update();

    const bars = root.querySelector("[data-bars]")!;
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting) {
            bars.classList.add("is-grown");
            io.disconnect();
          }
        },
        { threshold: 0.6 },
      );
      io.observe(bars);
    } else bars.classList.add("is-grown");
  }
</script>

<style>
  .rt-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .rt-head label {
    font-weight: 600;
    font-size: 1rem;
  }
  .rt-s {
    font-family: var(--mono);
    font-size: 1.5rem;
    color: var(--ink);
  }
  [data-level="high"] .rt-s {
    color: var(--red);
  }

  .rt-track {
    position: relative;
    margin-top: 1rem;
    padding-bottom: 1.6rem;
  }
  .rt-zones {
    display: flex;
    height: 2.5rem;
    border-radius: var(--radius);
    overflow: hidden;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .rt-zones span {
    display: flex;
    align-items: center;
    padding-inline: 0.75rem;
    white-space: nowrap;
  }
  .z-high {
    background: var(--red-soft);
    color: var(--red);
  }
  .z-med {
    background: repeating-linear-gradient(135deg, var(--rule) 0 3px, transparent 3px 6px);
  }
  .z-low {
    flex: 1;
    justify-content: flex-end;
    background: var(--ink-soft);
    color: var(--ink);
  }
  .rt-track input {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: 2.5rem;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: ew-resize;
  }
  .rt-track input::-webkit-slider-runnable-track {
    height: 2.5rem;
    background: transparent;
  }
  .rt-track input::-moz-range-track {
    height: 2.5rem;
    background: transparent;
  }
  .rt-track input::-webkit-slider-thumb {
    appearance: none;
    width: 6px;
    height: 3.25rem;
    margin-top: -0.375rem;
    border-radius: 3px;
    background: var(--text);
    box-shadow: 0 0 0 3px var(--paper-raised);
  }
  .rt-track input::-moz-range-thumb {
    width: 6px;
    height: 3.25rem;
    border: 0;
    border-radius: 3px;
    background: var(--text);
    box-shadow: 0 0 0 3px var(--paper-raised);
  }
  .rt-track input:focus-visible {
    outline-offset: 6px;
  }
  .rt-ticks span {
    position: absolute;
    bottom: 0;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--pencil);
  }
  .rt-ticks span:first-child {
    transform: translateX(-100%);
  }
  .rt-ticks span:last-child {
    transform: none;
  }

  .rt-verdict {
    margin-top: 0.75rem;
    min-height: 3.2em;
    font-size: 1.0625rem;
  }

  .rt-results {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .rt-sub {
    font-size: 0.875rem;
    color: var(--pencil);
    margin-bottom: 0.75rem;
  }
  .rt-bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .rt-row {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr) 4.75rem 3.5rem;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
  }
  .rt-bar-wrap {
    height: 0.9rem;
    border-radius: 2px;
    background: var(--rule-faint);
  }
  .rt-bar {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 2px;
    background: var(--pencil);
    transition: width 1.1s cubic-bezier(0.3, 0, 0.2, 1);
  }
  .is-grown .rt-bar {
    width: var(--w);
  }
  .mode-high .rt-bar {
    background: var(--red);
  }
  .mode-adaptive .rt-bar {
    background: var(--ink);
  }
  .mode-adaptive {
    font-weight: 600;
  }
  .rt-time,
  .rt-score {
    text-align: right;
  }
  .rt-score {
    color: var(--pencil);
  }
  .mode-adaptive .rt-score {
    color: var(--ink);
  }

  @media (max-width: 560px) {
    .rt-row {
      grid-template-columns: minmax(0, 1fr) 4.5rem 3.25rem;
      row-gap: 0.25rem;
    }
    .rt-mode {
      grid-column: 1 / -1;
    }
    .rt-zones span {
      padding-inline: 0.5rem;
    }
  }
</style>
