---
// RAG Lab notebook benchmarks (RAG-Enhancement/apps/web/src/lib/strategy-benchmarks.ts).
import { ragBenchmarks } from "../data/profile";

const metrics = [
  { key: "faithfulness", label: "Faithfulness" },
  { key: "contextPrecision", label: "Context precision" },
  { key: "contextRecall", label: "Context recall" },
  { key: "answerRelevancy", label: "Answer relevancy" },
] as const;
const data = JSON.stringify(ragBenchmarks);
---

<div class="figure rag" data-rag={data}>
  <div class="seg" role="group" aria-label="Metric">
    {
      metrics.map((m, i) => (
        <button type="button" data-metric={m.key} aria-pressed={i === 0 ? "true" : "false"}>
          {m.label}
        </button>
      ))
    }
  </div>
  <ol class="rg-list" data-list></ol>
  <p class="figure-caption">Results from the project's evaluation notebooks: seven retrieval strategies on Vietnamese documents, RAGAS metrics, higher is better.</p>
</div>

<script>
  type Row = Record<string, number | string>;
  for (const root of document.querySelectorAll<HTMLElement>("[data-rag]")) {
    const rows = JSON.parse(root.dataset.rag!) as Row[];
    const list = root.querySelector<HTMLElement>("[data-list]")!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-metric]")];
    const items = new Map<string, HTMLElement>();
    for (const r of rows) {
      const li = document.createElement("li");
      li.innerHTML = `<span class="rg-name"></span><span class="rg-bar"><span></span></span><span class="rg-val num"></span>`;
      li.querySelector(".rg-name")!.textContent = String(r.id);
      items.set(String(r.id), li);
      list.append(li);
    }
    const show = (k: string) => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.metric === k)));
      const sorted = [...rows].sort((a, b) => Number(b[k]) - Number(a[k]));
      sorted.forEach((r, i) => {
        const li = items.get(String(r.id))!;
        li.style.order = String(i);
        li.classList.toggle("is-top", i === 0);
        (li.querySelector(".rg-bar span") as HTMLElement).style.width = `${Number(r[k]) * 100}%`;
        li.querySelector(".rg-val")!.textContent = Number(r[k]).toFixed(3);
      });
    };
    buttons.forEach((b) => b.addEventListener("click", () => show(b.dataset.metric!)));
    show("faithfulness");
  }
</script>

<style>
  .rg-list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .rg-list :global(li) {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) 3.5rem;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.9375rem;
  }
  .rg-list :global(.rg-bar) {
    height: 0.8rem;
  }
  .rg-list :global(.rg-bar span) {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: var(--pencil);
    transition: width 0.45s cubic-bezier(0.3, 0, 0.2, 1);
  }
  .rg-list :global(li.is-top) {
    font-weight: 600;
  }
  .rg-list :global(li.is-top .rg-bar span) {
    background: var(--ink);
  }
  .rg-list :global(.rg-val) {
    text-align: right;
    font-family: var(--mono);
    font-size: 0.875rem;
  }
</style>
