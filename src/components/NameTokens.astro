---
// Hero: my name drawn as tokens. GPT-2's byte-level vocabulary splits each
// accented letter into several tokens, drawn as stacked rows inside one cell,
// like the four writing rows of an ô li square. The Vietnamese tokenizer
// needs one token per word.
import tokens from "../data/tokens.json";

const entry = tokens[0];
const chars = [...entry.text];
const data = JSON.stringify({ gpt2: entry.gpt2.map((t) => [t[0], t[1]]), vi: entry.vi.map((t) => [t[0], t[1]]) });
---

<div class="nt" data-nt={data} data-mode="vi">
  <h1 class="nt-name">
    <span class="sr-only">{entry.text}</span>
    <span class="nt-boxes" aria-hidden="true"></span>
    <span class="nt-glyphs" aria-hidden="true">{chars.map((c) => <span class="nt-c">{c}</span>)}</span>
  </h1>

  <div class="nt-controls">
    <div class="seg" role="group" aria-label="Tokenizer">
      <button type="button" data-mode-btn="vi" aria-pressed="true">My Vietnamese tokenizer</button>
      <button type="button" data-mode-btn="gpt2" aria-pressed="false">GPT-2</button>
    </div>
    <p class="nt-count" aria-live="polite">
      <strong class="num" data-count>{entry.vi.length}</strong>
      <span data-count-label>tokens with the tokenizer I trained for Vietnamese GPT-2</span>
    </p>
  </div>
</div>

<script>
  type Span = [number, number];
  type Mode = "vi" | "gpt2";
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const labels: Record<Mode, string> = {
    vi: "tokens with the tokenizer I trained for Vietnamese GPT-2",
    gpt2: "tokens with GPT-2, up to three for one accented letter",
  };

  for (const root of document.querySelectorAll<HTMLElement>("[data-nt]")) {
    const spans = JSON.parse(root.dataset.nt!) as Record<Mode, Span[]>;
    const name = root.querySelector<HTMLElement>(".nt-name")!;
    const layer = root.querySelector<HTMLElement>(".nt-boxes")!;
    const glyphs = [...root.querySelectorAll<HTMLElement>(".nt-c")];
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const countLabel = root.querySelector<HTMLElement>("[data-count-label]")!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-mode-btn]")];
    let mode: Mode = "vi";
    let timers: number[] = [];

    // One box per token; tokens that share the same letter become rows of that letter's cell.
    const layout = (list: Span[]) => {
      const base = name.getBoundingClientRect();
      const groups = new Map<string, number>();
      list.forEach(([s, e]) => groups.set(`${s}:${e}`, (groups.get(`${s}:${e}`) ?? 0) + 1));
      const seen = new Map<string, number>();
      return list.map(([s, e]) => {
        const key = `${s}:${e}`;
        const n = groups.get(key)!;
        const i = seen.get(key) ?? 0;
        seen.set(key, i + 1);
        const rects = glyphs.slice(s, e).map((g) => g.getBoundingClientRect());
        const left = Math.min(...rects.map((r) => r.left)) - base.left;
        const right = Math.max(...rects.map((r) => r.right)) - base.left;
        const top = Math.min(...rects.map((r) => r.top)) - base.top;
        const bottom = Math.max(...rects.map((r) => r.bottom)) - base.top;
        const h = (bottom - top) / n;
        return { left, width: right - left, top: top + i * h, height: h, slice: n > 1 };
      });
    };

    const clear = () => {
      timers.forEach(clearTimeout);
      timers = [];
    };

    const render = (next: Mode, animate: boolean) => {
      clear();
      mode = next;
      root.dataset.mode = next;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.modeBtn === next)));
      countLabel.textContent = labels[next];
      layer.replaceChildren();
      const boxes = layout(spans[next]).map((b) => {
        const el = document.createElement("span");
        el.className = "nt-box" + (b.slice ? " is-slice" : "");
        Object.assign(el.style, {
          left: `${b.left}px`,
          top: `${b.top}px`,
          width: `${b.width}px`,
          height: `${b.height}px`,
        });
        layer.append(el);
        return el;
      });
      if (!animate || reduce) {
        boxes.forEach((el) => el.classList.add("is-in"));
        count.textContent = String(boxes.length);
        return;
      }
      const step = next === "gpt2" ? 70 : 180;
      boxes.forEach((el, i) => {
        timers.push(
          window.setTimeout(() => {
            el.classList.add("is-in");
            count.textContent = String(i + 1);
          }, 120 + i * step),
        );
      });
    };

    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        introRunning = false;
        render(b.dataset.modeBtn as Mode, true);
      }),
    );

    // Page-load sequence: show what GPT-2 does to the name, then what the Vietnamese tokenizer does.
    let introRunning = false;
    const intro = () => {
      if (reduce) return render("vi", false);
      introRunning = true;
      render("gpt2", true);
      timers.push(
        window.setTimeout(() => {
          introRunning = false;
          render("vi", true);
        }, 120 + spans.gpt2.length * 70 + 1300),
      );
    };

    // Boxes are absolute pixels, so redraw them when the name reflows.
    let size = "";
    const measure = () => `${name.offsetWidth}x${name.offsetHeight}`;
    new ResizeObserver(() => {
      if (!size || measure() === size) return;
      size = measure();
      const settled = introRunning ? "vi" : mode;
      introRunning = false;
      render(settled, false);
    }).observe(name);
    document.fonts.ready.then(() => {
      size = measure();
      intro();
    });
  }
</script>

<style>
  .nt-name {
    position: relative;
    display: inline-block;
    font-size: clamp(3.25rem, 8.6vw, 7.5rem);
    line-height: 1.22;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: var(--ink);
  }
  .nt-glyphs {
    position: relative;
  }
  .nt-boxes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .nt-boxes :global(.nt-box) {
    position: absolute;
    border: 2px solid var(--ink);
    background: var(--ink-soft);
    border-radius: 3px;
    opacity: 0;
    transform: scale(0.92);
    transition:
      opacity 0.22s ease-out,
      transform 0.28s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .nt-boxes :global(.nt-box.is-in) {
    opacity: 1;
    transform: none;
  }
  [data-mode="gpt2"] .nt-boxes :global(.nt-box) {
    border-color: var(--red);
    background: var(--red-soft);
  }
  [data-mode="gpt2"] .nt-boxes :global(.nt-box.is-slice) {
    border-width: 1.5px;
    border-radius: 1px;
  }

  .nt-controls {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .nt-count {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.6rem;
    max-width: 30rem;
    color: var(--pencil);
    font-size: 0.9375rem;
    line-height: 1.35;
  }
  .nt-count strong {
    font-size: 2.25rem;
    line-height: 1;
    color: var(--ink);
    min-width: 1.4ch;
  }
  [data-mode="gpt2"] .nt-count strong {
    color: var(--red);
  }
</style>
