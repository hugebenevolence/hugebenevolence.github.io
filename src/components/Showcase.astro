---
// Real product screens, one at a time: recorded clips and screenshots of the running app.
import { Image } from "astro:assets";
import type { ShowcaseItem } from "../data/media";

interface Props {
  items: ShowcaseItem[];
  label: string;
}
const { items, label } = Astro.props;
const id = "sc-" + Math.random().toString(36).slice(2, 7);
---

<div class="figure showcase" data-showcase>
  {
    items.length > 1 && (
      <div class="seg sc-tabs" role="tablist" aria-label={label}>
        {items.map((it, i) => (
          <button
            type="button"
            role="tab"
            id={`${id}-t${i}`}
            aria-controls={`${id}-p${i}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-tab={i}
          >
            {it.label}
          </button>
        ))}
      </div>
    )
  }
  {
    items.map((it, i) => (
      <figure class="sc-panel" role="tabpanel" id={`${id}-p${i}`} aria-labelledby={`${id}-t${i}`} hidden={i !== 0} data-panel={i}>
        <div class="sc-screen">
          {it.video ? (
            <>
              <video
                muted
                loop
                playsinline
                preload="metadata"
                poster={it.video.poster}
                width={it.video.width}
                height={it.video.height}
                aria-label={it.alt}
              >
                <source src={it.video.src} type="video/mp4" />
              </video>
              <button type="button" class="sc-play" data-play aria-label="Play">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path class="i-play" d="M8 5v14l11-7z" fill="currentColor" />
                  <path class="i-pause" d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" />
                </svg>
              </button>
            </>
          ) : (
            it.image && <Image src={it.image} alt={it.alt} widths={[800, 1200, 1700]} sizes="(max-width: 900px) 100vw, 52rem" />
          )}
        </div>
        <figcaption class="figure-caption">{it.caption}</figcaption>
      </figure>
    ))
  }
</div>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  for (const root of document.querySelectorAll<HTMLElement>("[data-showcase]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    let visible = false;
    let userPaused = reduce;

    const sync = () => {
      for (const p of panels) {
        const v = p.querySelector("video");
        const btn = p.querySelector<HTMLButtonElement>("[data-play]");
        if (!v || !btn) continue;
        const shouldPlay = visible && !p.hidden && !userPaused;
        if (shouldPlay && v.paused) v.play().catch(() => {});
        if (!shouldPlay && !v.paused) v.pause();
        btn.setAttribute("aria-label", shouldPlay ? "Pause" : "Play");
        btn.dataset.state = shouldPlay ? "playing" : "paused";
      }
    };

    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute("aria-selected", String(i === j));
        t.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((p, j) => (p.hidden = i !== j));
      if (focus) tabs[i]?.focus();
      sync();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i));
      t.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (d) {
          e.preventDefault();
          select((i + d + tabs.length) % tabs.length, true);
        }
      });
    });
    root.querySelectorAll<HTMLButtonElement>("[data-play]").forEach((b) =>
      b.addEventListener("click", () => {
        userPaused = b.dataset.state === "playing";
        sync();
      }),
    );
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([e]) => {
          visible = e.isIntersecting;
          sync();
        },
        { threshold: 0.35 },
      ).observe(root);
    }
    sync();
  }
</script>

<style>
  .showcase {
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }
  .sc-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    background: transparent;
  }
  .sc-tabs button {
    position: relative;
    padding: 0.6rem 0;
    min-height: 40px;
    border-radius: 0;
    font-size: 0.9375rem;
    color: var(--muted);
    background: transparent;
    box-shadow: none;
  }
  .sc-tabs button[aria-selected="true"] {
    color: var(--text);
    background: transparent;
    box-shadow: none;
  }
  .sc-tabs button[aria-selected="true"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--text);
  }
  .sc-panel {
    margin: 0;
  }
  .sc-screen {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }
  .sc-screen :global(img),
  .sc-screen video {
    display: block;
    width: 100%;
    height: auto;
  }
  .sc-play {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: #111;
    cursor: pointer;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
  }
  .sc-play .i-pause,
  .sc-play[data-state="playing"] .i-play {
    display: none;
  }
  .sc-play[data-state="playing"] .i-pause {
    display: inline;
  }
  .sc-panel .figure-caption {
    margin-top: 0.75rem;
  }
</style>
