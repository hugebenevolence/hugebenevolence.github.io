---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import CvEntry from "../components/CvEntry.astro";
import { person } from "../data/profile";
import { headline, education, skills, experience, publications, projects, leadership, awards, certifications } from "../data/cv";
import portrait from "../assets/portrait.jpg";
---

<Base>
  <div class="cv wrap-narrow">
    <header class="cv-head">
      <div class="cv-head-text">
        <h1 class="cv-name">{person.name}</h1>
        <p class="cv-headline">{headline}</p>
        <ul class="cv-contact">
          <li>{person.city}</li>
          <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
          <li><a href={person.linkedin}>LinkedIn</a></li>
          <li><a href={person.github}>GitHub</a></li>
          <li><a href={person.orcid}>ORCID</a></li>
        </ul>
        <p class="cv-actions">
          <a class="btn btn-primary" href={person.cv}>Download CV (PDF)</a>
        </p>
      </div>
      <Image
        class="cv-photo"
        src={portrait}
        alt="Trần Đại Nhân speaking at an FCODER event."
        widths={[240, 480]}
        sizes="120px"
        loading="eager"
      />
    </header>

    <section id="education" class="cv-section">
      <h2 class="cv-h2">Education</h2>
      {education.map((e) => <CvEntry e={e} />)}
    </section>

    <section id="skills" class="cv-section">
      <h2 class="cv-h2">Technical skills</h2>
      <dl class="cv-skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.area}</dt>
              <dd>{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="experience" class="cv-section">
      <h2 class="cv-h2">Experience</h2>
      {experience.map((e) => <CvEntry e={e} />)}
    </section>

    <section id="research" class="cv-section">
      <h2 class="cv-h2">Research and publications</h2>
      {publications.map((e) => <CvEntry e={e} />)}
    </section>

    <section id="projects" class="cv-section">
      <h2 class="cv-h2">Selected projects</h2>
      {projects.map((e) => <CvEntry e={e} />)}
    </section>

    <section id="leadership" class="cv-section">
      <h2 class="cv-h2">Leadership, awards and certifications</h2>
      {leadership.map((e) => <CvEntry e={e} />)}
      <div class="cv-extra">
        <h3 class="cv-h3">Awards</h3>
        <ul class="cv-points">
          {awards.map((a) => <li>{a}</li>)}
        </ul>
        <h3 class="cv-h3">Certifications and languages</h3>
        <p>{certifications}</p>
      </div>
    </section>

    <section id="contact" class="cv-section cv-contact-section">
      <h2 class="cv-h2">Contact</h2>
      <p>
        Open to AI engineering roles and research collaborations. The fastest way to reach me is
        <a href={`mailto:${person.email}`}>{person.email}</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .wrap-narrow {
    width: min(880px, 100% - 40px);
    margin-inline: auto;
  }
  .cv {
    padding-block: clamp(2.5rem, 6vw, 4rem) 3rem;
  }

  .cv-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    padding-bottom: 2rem;
  }
  .cv-name {
    font-size: clamp(2.125rem, 5vw, 2.75rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .cv-headline {
    margin-top: 0.5rem;
    font-size: 1.0625rem;
    font-weight: 500;
  }
  .cv-contact {
    margin-top: 0.85rem;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .cv-actions {
    margin-top: 1.25rem;
  }
  .cv-head :global(.cv-photo) {
    width: 120px;
    height: 120px;
    object-fit: cover;
    object-position: 50% 18%;
    border-radius: 50%;
    border: 1px solid var(--border);
  }

  .cv-section {
    padding-top: 2.25rem;
  }
  .cv-h2 {
    font-size: 1.125rem;
    letter-spacing: 0;
    padding-bottom: 0.5rem;
    border-bottom: 1.5px solid var(--text);
    margin-bottom: 0.25rem;
  }
  .cv-h3 {
    font-size: 1rem;
    margin: 1.25rem 0 0.4rem;
  }

  .cv-skills {
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.45rem;
    font-size: 0.96875rem;
  }
  .cv-skills div {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 1rem;
  }
  .cv-skills dt {
    font-weight: 600;
  }
  .cv-skills dd {
    margin: 0;
    color: var(--muted);
  }

  .cv-extra {
    padding-top: 0.5rem;
    border-top: 1px dashed var(--border);
    font-size: 0.96875rem;
  }
  .cv-extra .cv-points {
    padding-left: 1.1rem;
    display: grid;
    gap: 0.3rem;
  }
  .cv-extra .cv-points li::marker {
    color: var(--muted);
  }
  .cv-extra p {
    color: var(--muted);
  }

  .cv-contact-section p {
    margin-top: 0.85rem;
  }

  @media (max-width: 640px) {
    .cv-head {
      grid-template-columns: minmax(0, 1fr);
    }
    .cv-head :global(.cv-photo) {
      order: -1;
      width: 88px;
      height: 88px;
    }
    .cv-skills div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
  }
</style>
