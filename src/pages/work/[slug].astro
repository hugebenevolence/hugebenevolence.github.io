---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Router from "../../components/Router.astro";
import Budget from "../../components/Budget.astro";
import Tokenizer from "../../components/Tokenizer.astro";
import VlmStages from "../../components/VlmStages.astro";
import TeachBack from "../../components/TeachBack.astro";
import PaymentSim from "../../components/PaymentSim.astro";
import Showcase from "../../components/Showcase.astro";
import { litreviewShots, kdhShots, smileShots, type ShowcaseItem } from "../../data/media";
import { person, work, vivqaX, cotResults, type Work } from "../../data/profile";

import vivqaFigure from "../../assets/vivqa-figure.png";

export function getStaticPaths() {
  const pages = work.filter((w) => w.page);
  return pages.map((item, i) => ({
    params: { slug: item.slug },
    props: { item, next: pages[(i + 1) % pages.length] },
  }));
}

interface Props {
  item: Work;
  next: Work;
}
const { item, next } = Astro.props;

const figures: Record<string, { title: string; component: any }> = {
  "adaptive-reasoning-vqa": { title: "Try the router", component: Router },
  "multi-mode-cot": { title: "Compare teacher budgets", component: Budget },
  "vietnamese-gpt2": { title: "Compare tokenizers", component: Tokenizer },
  "vietnamese-vlm": { title: "Training stages", component: VlmStages },
  "ke-doc-hanh": { title: "Two real golden-set turns", component: TeachBack },
  smile: { title: "Retries and double bookings, simulated", component: PaymentSim },
};
const figure = figures[item.slug];
const Figure = figure?.component;
const shots: Record<string, ShowcaseItem[]> = {
  litreview: litreviewShots,
  "ke-doc-hanh": kdhShots,
  smile: smileShots,
};
const screens = shots[item.slug];
const back = item.slug;
const meta = [
  ["Role", item.role],
  [item.kind === "research" ? "Venue" : "Context", item.venue ?? item.context],
  ["When", item.when],
  ["Team", item.team],
].filter(([, v]) => v) as [string, string][];
---

<Base title={`${item.name}, ${person.name}`} description={item.tagline}>
  <article class="wrap case">
    <a class="back" href={`/#${back}`}>Back to the CV</a>

    <header class="case-head">
      {item.status && <span class="badge">{item.status}</span>}
      <h1 class="case-title">{item.title}</h1>
      <p class="case-tagline">{item.tagline}</p>
      {item.authors && <p class="case-authors">{item.authors}</p>}
      <dl class="case-meta">
        {
          meta.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      {
        item.links.length > 0 && (
          <p class="link-row case-links">
            {item.links.map((l) => (
              <a href={l.href}>{l.label}</a>
            ))}
          </p>
        )
      }
    </header>

    {
      screens && (
        <div class="case-screens">
          <Showcase label={`${item.name} screens`} items={screens} />
        </div>
      )
    }

    {
      item.facts && (
        <ul class="case-facts">
          {item.facts.map((f) => (
            <li>
              <span class="cf-value num">{f.value}</span>
              <span class="cf-label">{f.label}</span>
            </li>
          ))}
        </ul>
      )
    }

    <section class="case-sec">
      <h2>Overview</h2>
      <div class="case-body">
        <p>{item.lead}</p>
        {item.body.map((p) => <p>{p}</p>)}
        {item.result && <p class="case-result">{item.result}</p>}
      </div>
    </section>

    {
      item.did && (
        <section class="case-sec">
          <h2>Highlights</h2>
          <div class="case-body">
            <ul class="case-list">
              {item.did.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      Figure && (
        <section class="case-sec">
          <h2>{figure.title}</h2>
          <div class="case-body case-figure">
            <Figure />
          </div>
        </section>
      )
    }

    {
      item.slug === "adaptive-reasoning-vqa" && (
        <section class="case-sec">
          <h2>Results on ViVQA-X</h2>
          <div class="case-body">
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">GPT-OSS mode</th>
                    <th scope="col">BLEU-4</th>
                    <th scope="col">ROUGE-L</th>
                    <th scope="col">METEOR</th>
                    <th scope="col">Time (s)</th>
                  </tr>
                </thead>
                <tbody>
                  {vivqaX.map((r) => (
                    <tr class={r.mode === "Adaptive" ? "is-ours" : ""}>
                      <th scope="row">{r.mode === "Adaptive" ? "Adaptive (ours)" : r.mode}</th>
                      <td>{r.bleu4.toFixed(3)}</td>
                      <td>{r.rougeL.toFixed(3)}</td>
                      <td>{r.meteor.toFixed(3)}</td>
                      <td>{r.time.toLocaleString("en-US")}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <figure class="case-fig">
              <Image
                src={vivqaFigure}
                alt="Framework diagram: a captioner describes the image, CLIP scores image–caption similarity s, thresholds τ_low and τ_high pick a reasoning mode r, and GPT-OSS answers the VQA prompt."
                widths={[520, 1040]}
                sizes="(max-width: 900px) 100vw, 40rem"
              />
              <figcaption class="figure-caption">The framework figure from the paper.</figcaption>
            </figure>
          </div>
        </section>
      )
    }

    {
      item.slug === "multi-mode-cot" && (
        <section class="case-sec">
          <h2>Results, Llama 3.2 3B, 0-shot</h2>
          <div class="case-body">
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Student</th>
                    <th scope="col">GSM8K</th>
                    <th scope="col">MATH500</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th scope="row">Before distillation</th>
                    <td>{cotResults.baseline.gsm8k.toFixed(4)}</td>
                    <td>{cotResults.baseline.math500.toFixed(4)}</td>
                  </tr>
                  {(["low", "medium", "high"] as const).map((b) => (
                    <tr class={b === "low" ? "is-ours" : ""}>
                      <th scope="row">SFT on {b}-budget traces, then GRPO</th>
                      <td>{cotResults.grpo[b].gsm8k.toFixed(4)}</td>
                      <td>{cotResults.grpo[b].math500.toFixed(4)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>
      )
    }

    <section class="case-sec">
      <h2>Built with</h2>
      <div class="case-body">
        <ul class="tags">
          {item.stack.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </section>

    {
      item.bibtex && (
        <section class="case-sec" id="cite">
          <h2>Cite</h2>
          <div class="case-body">
            <pre class="bib"><code>{item.bibtex}</code></pre>
            <button type="button" class="btn" data-copy-bib>
              Copy BibTeX
            </button>
          </div>
        </section>
      )
    }

    <nav class="case-next" aria-label="Next project">
      <span>Next</span>
      <a href={`/work/${next.slug}/`}>{next.name}</a>
    </nav>
  </article>
</Base>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-copy-bib]")) {
    b.addEventListener("click", async () => {
      const text = b.previousElementSibling?.textContent?.trim() ?? "";
      try {
        await navigator.clipboard.writeText(text);
        b.textContent = "Copied";
      } catch {
        b.textContent = "Select the text and copy it";
      }
      setTimeout(() => (b.textContent = "Copy BibTeX"), 1800);
    });
  }
</script>

<style>
  .case {
    padding-block: 2rem 4rem;
  }
  .back {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--muted);
  }
  .back:hover {
    color: var(--text);
  }
  .case-head {
    padding-block: 2rem 2.5rem;
    max-width: 52rem;
  }
  .case-head .badge {
    margin-bottom: 1rem;
  }
  .case-title {
    font-size: clamp(2rem, 4.4vw, 3rem);
    letter-spacing: -0.025em;
  }
  .case-tagline {
    margin-top: 0.85rem;
    font-size: 1.25rem;
    color: var(--muted);
    max-width: 40rem;
  }
  .case-authors {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .case-meta {
    margin: 1.75rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
  }
  .case-meta dt {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .case-meta dd {
    margin: 0.1rem 0 0;
    font-weight: 500;
  }
  .case-links {
    margin-top: 1.25rem;
  }
  .case-screens {
    margin-bottom: 2.5rem;
  }
  .case-facts {
    list-style: none;
    margin: 0 0 1rem;
    padding: 1.25rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .case-facts li {
    display: grid;
    align-content: start;
    gap: 0.2rem;
  }
  .cf-value {
    font-size: 1.5rem;
    font-weight: 600;
  }
  .cf-label {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .case-sec {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 2.5rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .case-sec h2 {
    font-size: 1.0625rem;
    line-height: 1.4;
  }
  .case-body {
    display: grid;
    gap: 1rem;
    min-width: 0;
    max-width: 46rem;
  }
  .case-figure {
    max-width: 52rem;
  }
  .case-figure :global(.figure) {
    margin-top: 0;
  }
  .case-result {
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    font-weight: 500;
  }
  .case-list {
    padding-left: 1.1rem;
    display: grid;
    gap: 0.6rem;
  }
  .case-list li::marker {
    color: var(--border-strong);
  }
  .case-fig {
    margin: 1rem 0 0;
  }
  .case-fig :global(img) {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #fff;
  }

  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border);
    text-align: right;
    white-space: nowrap;
  }
  thead th {
    color: var(--muted);
    font-weight: 500;
  }
  th[scope="row"],
  thead th:first-child {
    text-align: left;
    font-weight: 500;
    white-space: normal;
  }
  tr.is-ours th,
  tr.is-ours td {
    color: var(--accent);
    font-weight: 600;
  }

  .bib {
    margin: 0;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.55;
    white-space: pre;
  }
  [data-copy-bib] {
    justify-self: start;
  }

  .case-next {
    display: grid;
    gap: 0.25rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .case-next span {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .case-next a {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text);
  }
  .case-next a:hover {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .case-sec {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .case-facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
