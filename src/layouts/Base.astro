---
import "../styles/global.css";
import { person } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${person.name} (${person.latinName}), AI Engineer`,
  description = "Trần Đại Nhân is an AI engineer in Hà Nội working on applied NLP, LLM systems and the backend services that ship them.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const isHome = Astro.url.pathname === "/";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.name,
  alternateName: person.latinName,
  jobTitle: "AI Engineer",
  url: Astro.site?.toString(),
  email: `mailto:${person.email}`,
  address: { "@type": "PostalAddress", addressLocality: "Hà Nội", addressCountry: "VN" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "FPT University" },
  sameAs: [person.github, person.linkedin, person.orcid],
};

const nav = [
  { href: "/#experience", label: "Experience" },
  { href: "/#research", label: "Research" },
  { href: "/#projects", label: "Projects" },
  { href: "/#skills", label: "Skills" },
  { href: "/#contact", label: "Contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1215" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={isHome ? "profile" : "article"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar" data-topbar>
      <div class="wrap topbar-inner">
        <a class="brand" href="/">{person.name}</a>
        <nav class="topnav" aria-label="Sections">
          <ul>
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </nav>
        <div class="topbar-tools">
          <a class="btn btn-sm" href={person.cv}>CV</a>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch to dark theme">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
              <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"></path>
            </svg>
          </button>
          <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu>
            <span class="sr-only">Menu</span>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label="Sections" hidden>
        <ul class="wrap">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href={person.cv}>CV (PDF)</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <p>© 2026 {person.name}</p>
        <p class="footer-links">
          <a href={`mailto:${person.email}`}>Email</a>
          <a href={person.github}>GitHub</a>
          <a href={person.linkedin}>LinkedIn</a>
          <a href={person.orcid}>ORCID</a>
        </p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const isDark = () =>
        root.dataset.theme
          ? root.dataset.theme === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
      const label = () =>
        toggle?.setAttribute("aria-label", isDark() ? "Switch to light theme" : "Switch to dark theme");
      label();
      toggle?.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
        label();
      });

      const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu]");
      const mobileNav = document.getElementById("mobile-nav");
      const setMenu = (open: boolean) => {
        menuBtn?.setAttribute("aria-expanded", String(open));
        if (mobileNav) mobileNav.hidden = !open;
      };
      menuBtn?.addEventListener("click", () => setMenu(menuBtn.getAttribute("aria-expanded") !== "true"));
      mobileNav?.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("a")) setMenu(false);
      });

      const topbar = document.querySelector("[data-topbar]");
      const onScroll = () => topbar?.classList.toggle("is-scrolled", window.scrollY > 8);
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    padding: 0.5rem 0.75rem;
    background: var(--text);
    color: var(--bg);
    border-radius: var(--radius);
  }
  .skip:focus {
    top: 1rem;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .topbar.is-scrolled {
    border-bottom-color: var(--border);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4rem;
  }
  .brand {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text);
  }
  .brand:hover {
    text-decoration: none;
  }
  .topnav {
    margin-left: auto;
  }
  .topnav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .topnav a,
  .mobile-nav a {
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .topnav a:hover,
  .mobile-nav a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .topbar-tools {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .btn-sm {
    min-height: 34px;
    padding: 0.3rem 0.8rem;
    font-size: 0.875rem;
    margin-right: 0.25rem;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .icon-btn:hover {
    background: var(--surface);
    color: var(--text);
  }
  .menu-btn {
    display: none;
  }
  .mobile-nav {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .mobile-nav ul {
    list-style: none;
    padding-block: 0.5rem 1rem;
  }
  .mobile-nav li a {
    display: block;
    padding: 0.65rem 0;
    font-size: 1rem;
  }
  @media (max-width: 800px) {
    .topnav,
    .btn-sm {
      display: none;
    }
    .topbar-tools {
      margin-left: auto;
    }
    .menu-btn {
      display: grid;
    }
  }

  .footer {
    border-top: 1px solid var(--border);
    padding-block: 2rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  .footer-links a {
    color: var(--muted);
  }
  .footer-links a:hover {
    color: var(--text);
  }
</style>
